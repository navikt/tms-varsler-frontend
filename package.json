{
  "name": "tms-varsler-frontend",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "PUBLIC_APP_ENVIRONMENT=local astro dev",
    "start": "PUBLIC_APP_ENVIRONMENT=${PUBLIC_APP_ENVIRONMENT:-local} astro dev",
    "build": "PUBLIC_APP_ENVIRONMENT=${PUBLIC_APP_ENVIRONMENT:-local} astro check && PUBLIC_APP_ENVIRONMENT=${PUBLIC_APP_ENVIRONMENT:-local} astro build",
    "preview": "PUBLIC_APP_ENVIRONMENT=${PUBLIC_APP_ENVIRONMENT:-local} astro preview",
    "astro": "PUBLIC_APP_ENVIRONMENT=${PUBLIC_APP_ENVIRONMENT:-local} astro",
    "test": "PUBLIC_APP_ENVIRONMENT=local vitest run",
    "test:watch": "PUBLIC_APP_ENVIRONMENT=local vitest",
    "test:coverage": "PUBLIC_APP_ENVIRONMENT=local vitest run --coverage",
    "test:e2e": "playwright test",
    "ts-check": "tsc --strict",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/node": "11.1.3",
    "@astrojs/react": "6.0.3",
    "@nanostores/react": "1.1.0",
    "@navikt/aksel-icons": "8.16.1",
    "@navikt/astro-logger": "1.0.0",
    "@navikt/ds-react": "8.10.4",
    "@navikt/nav-dekoratoren-moduler": "4.3.0",
    "@navikt/astro-auth": "1.0.8",
    "@navikt/oasis": "3.8.0",
    "astro": "7.2.3",
    "dayjs": "1.11.23",
    "husky": "9.1.7",
    "nanostores": "1.5.1",
    "prom-client": "15.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "swr": "2.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.9",
    "@navikt/astro-mocks": "0.1.5",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.0.14",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "30.0.1",
    "typescript": "5.8.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "8.1.3"
    }
  }
}
